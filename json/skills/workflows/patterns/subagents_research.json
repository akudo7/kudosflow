{
  "$schema": "https://scenegraphmanager.com/schema/workflow.json",
  "config": {
    "name": "research_subagents_workflow",
    "description": "Research workflow with subagents as tools pattern",
    "recursionLimit": 50
  },
  "stateAnnotation": {
    "name": "ResearchState",
    "type": "Annotation.Root"
  },
  "annotation": {
    "messages": {
      "type": "BaseMessage[]",
      "reducer": "(x, y) => x.concat(y)",
      "default": "[]"
    },
    "researchTopic": {
      "type": "string",
      "default": "''"
    },
    "researchResults": {
      "type": "string[]",
      "reducer": "(x, y) => [...x, ...y]",
      "default": "[]"
    },
    "writtenContent": {
      "type": "string",
      "default": "''"
    },
    "reviewedContent": {
      "type": "string",
      "default": "''"
    }
  },
  "models": [
    {
      "id": "coordinator",
      "type": "anthropic",
      "config": {
        "model": "claude-3-5-sonnet-20241022",
        "apiKey": "${ANTHROPIC_API_KEY}",
        "maxTokens": 4096
      },
      "systemPrompt": "You are a research coordinator. You delegate research tasks to specialist subagents and synthesize their findings."
    },
    {
      "id": "researcher",
      "type": "anthropic",
      "config": {
        "model": "claude-3-5-sonnet-20241022",
        "apiKey": "${ANTHROPIC_API_KEY}",
        "maxTokens": 2048
      },
      "systemPrompt": "You are a research specialist. Conduct thorough research on given topics and return structured findings."
    },
    {
      "id": "writer",
      "type": "anthropic",
      "config": {
        "model": "claude-3-5-sonnet-20241022",
        "apiKey": "${ANTHROPIC_API_KEY}",
        "maxTokens": 4096
      },
      "systemPrompt": "You are a professional writer. Transform research findings into clear, engaging content."
    },
    {
      "id": "reviewer",
      "type": "anthropic",
      "config": {
        "model": "claude-3-5-sonnet-20241022",
        "apiKey": "${ANTHROPIC_API_KEY}",
        "maxTokens": 2048
      },
      "systemPrompt": "You are a content reviewer. Review written content for accuracy, clarity, and completeness."
    }
  ],
  "nodes": [
    {
      "id": "coordinate",
      "type": "model",
      "modelRef": "coordinator",
      "handler": {
        "parameters": [
          {
            "name": "state",
            "parameterType": "state",
            "stateType": "typeof ResearchState.State"
          }
        ],
        "function": "async (state) => { return { messages: [{ role: 'user', content: `Research topic: ${state.researchTopic}` }] }; }"
      }
    },
    {
      "id": "research_subagent",
      "type": "function",
      "handler": {
        "parameters": [
          {
            "name": "state",
            "parameterType": "state",
            "stateType": "typeof ResearchState.State"
          },
          {
            "name": "model",
            "parameterType": "model",
            "modelRef": "researcher"
          }
        ],
        "function": "async (state, model) => { const result = await model.invoke([{ role: 'user', content: `Research this topic: ${state.researchTopic}` }]); return { researchResults: [result.content.toString()], messages: [{ role: 'assistant', content: `Research completed: ${result.content}` }] }; }"
      }
    },
    {
      "id": "writer_subagent",
      "type": "function",
      "handler": {
        "parameters": [
          {
            "name": "state",
            "parameterType": "state",
            "stateType": "typeof ResearchState.State"
          },
          {
            "name": "model",
            "parameterType": "model",
            "modelRef": "writer"
          }
        ],
        "function": "async (state, model) => { const result = await model.invoke([{ role: 'user', content: `Write an article based on this research: ${state.researchResults.join('\\n\\n')}` }]); return { writtenContent: result.content.toString(), messages: [{ role: 'assistant', content: `Article written: ${result.content}` }] }; }"
      }
    },
    {
      "id": "reviewer_subagent",
      "type": "function",
      "handler": {
        "parameters": [
          {
            "name": "state",
            "parameterType": "state",
            "stateType": "typeof ResearchState.State"
          },
          {
            "name": "model",
            "parameterType": "model",
            "modelRef": "reviewer"
          }
        ],
        "function": "async (state, model) => { const result = await model.invoke([{ role: 'user', content: `Review this article: ${state.writtenContent}` }]); return { reviewedContent: result.content.toString(), messages: [{ role: 'assistant', content: `Review complete: ${result.content}` }] }; }"
      }
    }
  ],
  "edges": [
    {
      "from": "__start__",
      "to": "coordinate"
    },
    {
      "from": "coordinate",
      "to": "research_subagent"
    },
    {
      "from": "research_subagent",
      "to": "writer_subagent"
    },
    {
      "from": "writer_subagent",
      "to": "reviewer_subagent"
    },
    {
      "from": "reviewer_subagent",
      "to": "__end__"
    }
  ],
  "stateGraph": {
    "annotationRef": "ResearchState"
  }
}
