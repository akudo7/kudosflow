{
  "config": {
    "name": "Peer Collaboration Example",
    "description": "Demonstrates peer-to-peer agent collaboration with negotiation",
    "recursionLimit": 50,
    "peerCollaboration": {
      "peers": {
        "researcher": {
          "id": "researcher",
          "name": "Research Agent",
          "capabilities": "research, data analysis, information gathering",
          "modelRef": "claude",
          "systemPrompt": "You are a research agent specialized in gathering and analyzing information. You can request help from other agents when needed.",
          "tools": ["web_search", "database_query"],
          "skills": ["research_methodology"],
          "priority": 8
        },
        "writer": {
          "id": "writer",
          "name": "Content Writer Agent",
          "capabilities": "writing, content creation, editing",
          "modelRef": "claude",
          "systemPrompt": "You are a content writer agent specialized in creating high-quality written content. You collaborate with researchers to create well-informed articles.",
          "tools": ["grammar_check", "style_guide"],
          "skills": ["content_writing"],
          "priority": 7
        },
        "reviewer": {
          "id": "reviewer",
          "name": "Review Agent",
          "capabilities": "review, quality assurance, fact-checking",
          "modelRef": "claude",
          "systemPrompt": "You are a review agent specialized in quality assurance and fact-checking. You ensure content meets quality standards.",
          "tools": ["fact_check", "style_validator"],
          "skills": ["quality_assurance"],
          "priority": 9
        }
      },
      "maxHops": 5,
      "messageTimeout": 30000,
      "enableNegotiation": true,
      "broadcastDefault": false
    }
  },
  "stateAnnotation": {
    "name": "PeerCollaborationState",
    "type": "Annotation.Root"
  },
  "annotation": {
    "messages": {
      "type": "BaseMessage[]",
      "reducer": "(x, y) => x.concat(y)",
      "default": "[]"
    },
    "topic": {
      "type": "string",
      "default": "\"\""
    },
    "researchComplete": {
      "type": "boolean",
      "default": "false"
    },
    "draftComplete": {
      "type": "boolean",
      "default": "false"
    },
    "reviewComplete": {
      "type": "boolean",
      "default": "false"
    },
    "finalArticle": {
      "type": "string",
      "default": "\"\""
    }
  },
  "models": [
    {
      "id": "claude",
      "type": "anthropic",
      "config": {
        "model": "claude-3-5-sonnet-20241022",
        "maxTokens": 4096
      }
    }
  ],
  "nodes": [
    {
      "id": "coordinator",
      "type": "function",
      "handler": {
        "parameters": [
          {
            "name": "state",
            "parameterType": "state",
            "stateType": "typeof PeerCollaborationState.State"
          }
        ],
        "function": "async (state) => { console.log('Starting peer collaboration workflow for topic:', state.topic); return { messages: [{ role: 'system', content: 'Coordination started' }] }; }"
      }
    },
    {
      "id": "negotiate_researcher",
      "type": "function",
      "handler": {
        "parameters": [
          {
            "name": "state",
            "parameterType": "state",
            "stateType": "typeof PeerCollaborationState.State"
          }
        ],
        "function": "async (state) => { console.log('Negotiating with researcher for topic:', state.topic); return { researchComplete: true, messages: [{ role: 'assistant', content: 'Research negotiation complete' }] }; }"
      }
    },
    {
      "id": "negotiate_writer",
      "type": "function",
      "handler": {
        "parameters": [
          {
            "name": "state",
            "parameterType": "state",
            "stateType": "typeof PeerCollaborationState.State"
          }
        ],
        "function": "async (state) => { console.log('Negotiating with writer for content creation'); return { draftComplete: true, messages: [{ role: 'assistant', content: 'Writing negotiation complete' }] }; }"
      }
    },
    {
      "id": "negotiate_reviewer",
      "type": "function",
      "handler": {
        "parameters": [
          {
            "name": "state",
            "parameterType": "state",
            "stateType": "typeof PeerCollaborationState.State"
          }
        ],
        "function": "async (state) => { console.log('Negotiating with reviewer for quality assurance'); return { reviewComplete: true, messages: [{ role: 'assistant', content: 'Review negotiation complete' }] }; }"
      }
    },
    {
      "id": "finalize",
      "type": "function",
      "ends": true,
      "handler": {
        "parameters": [
          {
            "name": "state",
            "parameterType": "state",
            "stateType": "typeof PeerCollaborationState.State"
          }
        ],
        "function": "async (state) => { console.log('Peer collaboration complete!'); return { finalArticle: 'Final article created through peer collaboration', messages: [{ role: 'assistant', content: 'Workflow complete' }] }; }"
      }
    }
  ],
  "edges": [
    {
      "from": "__start__",
      "to": "coordinator"
    },
    {
      "from": "coordinator",
      "to": "negotiate_researcher"
    },
    {
      "from": "negotiate_researcher",
      "to": "negotiate_writer"
    },
    {
      "from": "negotiate_writer",
      "to": "negotiate_reviewer"
    },
    {
      "from": "negotiate_reviewer",
      "to": "finalize"
    },
    {
      "from": "finalize",
      "to": "__end__"
    }
  ],
  "stateGraph": {
    "annotationRef": "PeerCollaborationState"
  }
}
